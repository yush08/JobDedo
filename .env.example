# ---------------------------------------------------------------------------
# JobDedo environment variables
# Copy this file to `.env.local` and fill in what you have.
# NOTHING here is required to run the app locally: without Supabase credentials
# JobDedo uses a local file-backed store (see README "Local mode").
# NEVER expose any of these values to the browser (all must stay server-side).
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------
# Public base URL of the deployment (used for links in generated emails/docs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (server-only) -----------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API.
# Use the SERVICE ROLE key only on the server. It must never be imported by a
# client component. JobDedo does NOT use Supabase Auth.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket that holds uploaded / generated resumes (private bucket).
SUPABASE_STORAGE_BUCKET=resumes

# --- Storage driver override ---------------------------------------------
# "auto" (default) -> Supabase when the two variables above are set, otherwise
# the local JSON store in .data/jobdedo.local.json
JOBDEDO_DATA_DRIVER=auto

# --- AI provider (Milestone 5+, optional) ---------------------------------
# JobDedo uses an AI provider abstraction; only one provider needs to be set.
# gemini | openai | anthropic | ollama
JOBDEDO_AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local inference (optional). Example: http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Gmail OAuth (Milestone 6, optional) ----------------------------------
# Sending is always explicitly approved by the user, never automatic.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discovery (Milestone 2) ----------------------------------------------
# Real source adapters (Greenhouse / Lever / Ashby). Every value below has a
# safe default: with NOTHING set, a fresh clone still runs real discovery.
# Full reference: docs/discovery-sources.md
#
# Which adapters a run may construct (comma-separated).
DISCOVERY_SOURCES_ENABLED=greenhouse,lever,ashby
# Greenhouse board tokens: https://job-boards.greenhouse.io/{token}/jobs/…
DISCOVERY_GREENHOUSE_BOARDS=dropbox,vercel
# Lever slugs as slug=Display Name (Lever never publishes the company name).
DISCOVERY_LEVER_POSTINGS=spotify=Spotify
# Ashby board names as Board=Display Name.
DISCOVERY_ASHBY_BOARDS=Linear

# Bounded execution budgets (see docs/discovery-sources.md for ranges).
# Hard cap on HTTP requests for one run (default 12; scheduled runs may
# raise it, e.g. 40).
JOBDEDO_DISCOVERY_MAX_REQUESTS_PER_RUN=12
# Adapters fetching at the same time (default 2, range 1–6).
JOBDEDO_DISCOVERY_CONCURRENCY=2
# Per-request timeout in ms (default 15000, range 1000–60000).
JOBDEDO_DISCOVERY_TIMEOUT_MS=15000
# Listings normalised per source per run (default 250, range 1–5000).
JOBDEDO_DISCOVERY_MAX_JOBS_PER_SOURCE=250
# New listings probed by the verification engine per run (default 8,
# range 0–50; 0 disables verification probing).
JOBDEDO_DISCOVERY_VERIFY_LIMIT=8
# Touched listings scored by the matching engine per run (default 50,
# range 0–500; 0 disables matching).
JOBDEDO_DISCOVERY_MATCH_LIMIT=50
